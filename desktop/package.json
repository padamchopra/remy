{
  "name": "remy-desktop",
  "productName": "Remy",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:mac": "node scripts/stage-bundle.mjs && npm run build && node scripts/pack-mac.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "me.padamchopra.Remy",
    "productName": "Remy",
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/server",
        "to": "server"
      },
      {
        "from": "build/server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Remy-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Remy reads the workspace folders you add from Documents.",
        "NSDesktopFolderUsageDescription": "Remy reads the workspace folders you add from Desktop.",
        "NSDownloadsFolderUsageDescription": "Remy reads the workspace folders you add from Downloads.",
        "NSNetworkVolumesUsageDescription": "Remy reads the workspace folders you add from network drives.",
        "NSRemovableVolumesUsageDescription": "Remy reads the workspace folders you add from removable drives."
      }
    },
    "dmg": {
      "title": "Remy ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "padamchopra",
      "repo": "remy"
    }
  }
}
