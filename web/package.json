{
  "name": "remy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hub": "npm run build && npm run build:website && node scripts/assemble-hub.mjs && node ../hub/scripts/build-runtime.mjs",
    "bundle": "node scripts/bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shoot.mjs",
    "perf:test": "node --test scripts/composer-draft.test.mjs scripts/shared-read.test.mjs scripts/thread-entry-merge.test.mjs scripts/thread-workbench.test.mjs scripts/warm-cache.test.mjs",
    "live-check": "node scripts/live-check.mjs",
    "dev:website": "vite --config vite.website.config.ts",
    "build:website": "tsc -p tsconfig.website.json && vite build --config vite.website.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@blobatar/react": "^2.5.0",
    "@remy/contract": "file:../contract",
    "@shadcn/react": "^0.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "blobatar": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
